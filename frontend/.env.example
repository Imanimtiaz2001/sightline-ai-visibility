# ---------------------------------------------------------------------------
# Sightline frontend – runtime settings
# The production image writes /config.json from these variables when the
# container starts, so one build runs in every environment. For local
# development (`npm start`) edit public/config.json instead – same keys.
# ---------------------------------------------------------------------------

# Base URL of the backend API as seen by the browser. Keep "/api/v1" when the
# frontend container proxies to the backend (docker compose default); use a full
# URL (https://api.example.com/api/v1) if the API is on another origin and add
# that origin to the backend's CORS_ORIGINS.
API_BASE_URL=/api/v1

# Send browser errors to POST /api/v1/client-errors (true|false)
ERROR_REPORTING=true

# Polling interval (ms) used only if the live progress stream is unavailable
RUN_POLL_INTERVAL_MS=2000

# Release identifier attached to error reports
RELEASE=1.0.0

# nginx upstream for /api and /health (host:port of the backend container)
BACKEND_UPSTREAM=backend:8000
