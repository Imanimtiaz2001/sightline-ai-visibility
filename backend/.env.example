# ---------------------------------------------------------------------------
# AI Visibility Platform – backend configuration
# Copy to `.env` (next to docker-compose.yml for Docker, or in backend/ for
# local runs). Every value here has a default except the credentials.
# ---------------------------------------------------------------------------

# --- Required: live data (DataForSEO) ---------------------------------------
# API login + password from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Required: LLM ------------------------------------------------------------
# anthropic | openai   (fixtures = deterministic offline model, tests/demo only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave empty for the provider default (anthropic: claude-sonnet-5-5, openai: gpt-4.1)
LLM_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=4096
# Repair turns given to the model when its output fails validation
LLM_REPAIR_ATTEMPTS=1

# --- Data mode ------------------------------------------------------------------
# live (default) | fixtures (synthetic responses for tests/offline demo; shown as a banner in the UI)
DATAFORSEO_MODE=live
DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3
# Offline demo only (DATAFORSEO_MODE=fixtures): simulated provider latency in ms
FIXTURE_LATENCY_MS=0
# AI assistants measured, as engine:model (engines: chat_gpt, perplexity, gemini, claude)
AI_ENGINES=chat_gpt:gpt-4.1-mini,perplexity:sonar

# --- Timeouts & retries -----------------------------------------------------------
DATAFORSEO_CONNECT_TIMEOUT_S=5
DATAFORSEO_READ_TIMEOUT_S=45
# AI-answer endpoints run live tasks for up to 120 s
DATAFORSEO_LLM_READ_TIMEOUT_S=125
# Concurrent DataForSEO requests (provider limit is 30)
DATAFORSEO_MAX_CONCURRENCY=6
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_S=0.5
RETRY_MAX_DELAY_S=8
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_S=30

# --- Cost & scope -------------------------------------------------------------------
# Hard ceiling of DataForSEO spend per run (calls that would exceed it are skipped and flagged)
MAX_COST_PER_RUN_USD=1.50
MAX_DISCOVERY_CALLS=4
MAX_QUERIES_PER_RUN=8
MAX_RECOMMENDATIONS=5
# Cache TTLs (hours): keyword data changes monthly; SERP / AI answers change daily
CACHE_TTL_KEYWORDS_H=168
CACHE_TTL_SERP_H=12
CACHE_TTL_LLM_H=12

# --- Service --------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json (production) | console (human-readable)
LOG_FORMAT=json
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
MAX_CONCURRENT_RUNS=3
RUN_WORKER_THREADS=3
MAX_REQUEST_BYTES=65536
# Optional: send unhandled errors to Sentry
SENTRY_DSN=
